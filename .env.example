# Copy this to .env and fill in real values. .env is gitignored.

# --- Alpaca (paper trading) ---
ALPACA_API_KEY=PK_paper_key_from_alpaca
ALPACA_API_SECRET=secret_from_alpaca
ALPACA_API_BASE_URL=https://paper-api.alpaca.markets/v2
ALPACA_ENVIRONMENT=paper

# --- Anthropic (Claude API for AI strategy) ---
ANTHROPIC_API_KEY=sk-ant-your-key-here
CLAUDE_MODEL=claude-sonnet-4-6

# --- Email (Gmail SMTP for morning_routine.py + eod_routine.py) ---
# Generate an app password: https://myaccount.google.com/apppasswords
# (requires 2-Step Verification enabled on the Google account)
# Yahoo no longer reliably supports SMTP app passwords — use Gmail or Outlook.com.
EMAIL_USER=trading.klaaswierenga@gmail.com
EMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx
EMAIL_TO=trading.klaaswierenga@gmail.com
# Optional SMTP overrides — defaults below are Gmail. For Outlook.com, use:
#   EMAIL_SMTP_HOST=smtp-mail.outlook.com
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
